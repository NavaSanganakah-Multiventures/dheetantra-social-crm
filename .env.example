# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META WHATSAPP EMBEDDED SIGNUP
# Provide your Facebook App ID for the Embedded Signup flow
NEXT_PUBLIC_FB_APP_ID="YOUR_FB_APP_ID"
NEXT_PUBLIC_FB_CONFIG_ID="YOUR_FB_CONFIG_ID"

# ==========================================
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# FCM Server-Side Push (Service Account JSON)
# Set this in your Cloudflare KV / Environment variables for the Worker
# FCM_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# ==========================================
# CLOUDFLARE EDGE CONFIGURATION / INSTRUCTIONS
# ==========================================

# 1. KV SECRETS: 
# Since we are using Workers KV for secrets (SECRETS_KV namespace), you must set the following keys in your KV manually in production:
# - GEMINI_API_KEY
# - WHATSAPP_API_TOKEN
# - WHATSAPP_VERIFY_TOKEN
# - META_USER_ACCESS_TOKEN
# - META_SYSTEM_USER_TOKEN
# - TURN_KEY_ID / CLOUDFLARE_CALLS_APP_ID
# - TURN_KEY_API_TOKEN / CLOUDFLARE_API_TOKEN
# - FCM_SERVICE_ACCOUNT_JSON
# - FB_APP_ID
# - FB_CONFIG_ID
# - ADMIN_EMAILS

# 2. D1 DATABASE:
# The local schema is in `schema.sql`. You initialize your local / production DB via:
# `npx wrangler d1 execute omnichannel-db --file=./schema.sql --local`
#
# Remember to configure wrangler.toml like so:
# [[d1_databases]]
# binding = "DB"
# database_name = "omnichannel-db"
# database_id = "..."
#
# [[kv_namespaces]]
# binding = "SECRETS_KV"
# id = "..."
